def node = rootProject.project(":${stonecutter.current.version}")
def unobf = node.findProperty('unobfuscated') == 'true'
def javaVer = (node.findProperty('java_version') ?: '21') as int
def mcVersion = node.property('minecraft_version')
def archVersion = node.property('architectury_version')
def neoforgeVersion = node.property('neoforge_version')
def floaderVersion = node.property('fabric_loader_version')
def commonProject = ":common:${stonecutter.current.version}"

// Force the matching common node to fully evaluate first, then read its Stonecutter-processed
// source/resource directories directly off the project object (see fabric/build.gradle for why).
def commonNode = evaluationDependsOn(commonProject)

apply plugin: unobf ? "mightyarchitect.loomonly-noremap" : "mightyarchitect.loomonly-remap"
apply plugin: "java"
apply plugin: "maven-publish"

base { archivesName = "${rootProject.archives_base_name}-${mcVersion}" }
version = rootProject.mod_version
group = rootProject.maven_group

repositories {
    maven { url "https://maven.neoforged.net/releases/" }
}

loom {
    silentMojangMappingsLicense()
}

dependencies {
    minecraft "com.mojang:minecraft:${mcVersion}"
    neoForge "net.neoforged:neoforge:${neoforgeVersion}"
    // common uses Fabric's @Environment/EnvType annotations (loader-neutral in the architectury
    // model). Provide them at compile time only; they are CLASS-retention and ignored at runtime
    // on NeoForge. (Sidedness-annotation conversion to @OnlyIn is a production follow-up.)
    compileOnly "net.fabricmc:fabric-loader:${floaderVersion}"
    if (unobf) {
        // Unobfuscated 26.1: no remap / no mappings.
        implementation "dev.architectury:architectury-neoforge:${archVersion}"
    } else {
        mappings loom.officialMojangMappings()
        implementation "dev.architectury:architectury-neoforge:${archVersion}"
    }
    implementation 'com.google.code.findbugs:jsr305:3.0.2'
}

// Feed common's Stonecutter-processed source/resource directories into the compile TASK directly.
def commonMain = commonNode.sourceSets.main
tasks.named("compileJava") {
    dependsOn("${commonProject}:classes")
    source(commonMain.java.sourceDirectories)
}
tasks.named("processResources") {
    dependsOn("${commonProject}:processResources")
    from(commonMain.resources.sourceDirectories)
    inputs.property "version", project.version
    filesMatching("META-INF/neoforge.mods.toml") {
        expand "version": project.version
    }
}

tasks.withType(JavaCompile).configureEach {
    options.encoding = "UTF-8"
    options.release = javaVer
}

java {
    toolchain {
        languageVersion = JavaLanguageVersion.of(javaVer)
    }
}

if (!unobf) {
    remapJar {
        archiveClassifier.set("neoforge")
    }
    jar {
        archiveClassifier.set("dev")
    }
} else {
    // Unobfuscated 26.1: no remap step; the plain jar is the published artifact.
    jar {
        archiveClassifier.set("neoforge")
    }
}

publishing {
    publications {
        mavenNeoForge(MavenPublication) {
            artifactId = rootProject.archives_base_name + "-neoforge"
            from components.java
        }
    }
    repositories {}
}
